<Window x:Class="TotaPetAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TotaPetAI"
        Width="220"
        Height="260"
        MinWidth="180"
        MinHeight="220"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        ShowActivated="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Wróć do domyślnej pozycji" Click="ResetPosition_Click" />
            <Separator />
            <MenuItem Header="Zamknij TotaPetAI" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="10">
        <Border Background="#FFF9F4"
                BorderBrush="#FFE2D4"
                BorderThickness="1"
                CornerRadius="28"
                Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.22" ShadowDepth="5" Color="#5A3B52" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <TextBlock Text="TotaPetAI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="×"
                            Width="24"
                            Height="24"
                            Margin="4,0,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource MutedBrush}"
                            FontSize="18"
                            ToolTip="Zamknij"
                            Click="Exit_Click"
                            DockPanel.Dock="Right" />
                </DockPanel>

                <Grid Grid.Row="1" MouseLeftButtonDown="Pet_MouseLeftButtonDown">
                    <Ellipse Width="112" Height="112" Fill="#F5B9A8" Stroke="#E9927E" StrokeThickness="3" />
                    <Path Fill="#F5B9A8" Stroke="#E9927E" StrokeThickness="3"
                          Data="M 61,52 L 48,20 L 78,39 Z" />
                    <Path Fill="#F5B9A8" Stroke="#E9927E" StrokeThickness="3"
                          Data="M 159,52 L 172,20 L 142,39 Z" />
                    <Ellipse Width="12" Height="17" Fill="#241B35" Margin="-30,0,0,0" />
                    <Ellipse Width="12" Height="17" Fill="#241B35" Margin="30,0,0,0" />
                    <Ellipse Width="12" Height="8" Fill="#FF7A59" Margin="0,30,0,0" />
                    <Path Stroke="#241B35" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 101,113 Q 110,122 119,113" />
                    <TextBlock Text="•ᴗ•"
                               FontSize="15"
                               Foreground="#FFF9F4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,7" />
                </Grid>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <TextBlock Text="Cześć! Jestem Tota."
                               Foreground="{DynamicResource InkBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Przeciągnij mnie w wybrane miejsce"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
